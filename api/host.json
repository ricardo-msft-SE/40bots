{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true },
      "enableLiveMetricsFilters": true,
      "httpAutoCollectionOptions": { "enableHttpTriggerExtendedInfoCollection": false }
    }
  },
  "extensions": {
    "http": { "routePrefix": "api", "maxOutstandingRequests": 20, "maxConcurrentRequests": 10 }
  }
}
